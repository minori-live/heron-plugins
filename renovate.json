{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":configMigration",
    "security:minimumReleaseAgeNpm",
    "schedule:weekly"
  ],
  "prConcurrentLimit": 2,
  "separateMajorMinor": false,
  "groupSingleUpdates": true,
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "lock"
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": false,
      "schedule": ["* * 1 * *"]
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "update"
    },
    {
      "description": "windows-core must match windows 0.62's generated COM traits and implement macro.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["windows-core"],
      "allowedVersions": "<0.63"
    },
    {
      "description": "third_party crates are vendored published releases plus Heron Plugins patches; bumping their internal dependencies breaks source that only moves with an upstream release.",
      "matchManagers": ["cargo"],
      "matchFileNames": ["third_party/**"],
      "enabled": false
    }
  ]
}
