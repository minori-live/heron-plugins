{
  "name": "heron-plugins",
  "version": "0.6.5",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "26.x",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "check": "tsc6 --noEmit && node --test scripts/*.test.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "version:check": "node scripts/version.ts check",
    "version:sync": "node scripts/version.ts sync"
  },
  "devDependencies": {
    "@sentry/cli": "3.8.0",
    "@types/node": "26.5.1",
    "@types/yazl": "3.3.1",
    "fflate": "0.8.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unzipper": "0.12.5",
    "yazl": "3.3.1"
  }
}
